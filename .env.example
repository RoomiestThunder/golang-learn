# Скопируй в .env и заполни:  cp .env.example .env

# Адрес, по которому будешь открывать платформу, без https://
# Свой домен (A-запись должна указывать на IP сервера) или, если домена нет,
# IP через дефисы + .sslip.io, например для 203.0.113.5:  203-0-113-5.sslip.io
DOMAIN=

# Пароль для входа, минимум 12 символов. Надёжный вариант:  openssl rand -hex 16
# Используй буквы и цифры: символы $ и кавычки Docker Compose понимает по-своему.
GOLEARN_PASSWORD=
